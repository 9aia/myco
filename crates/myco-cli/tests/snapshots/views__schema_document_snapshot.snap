      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "ItemId",
      "type": "string"
    },
    "ItemKind": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "The kind of work item an [`ItemId`] addresses.",
      "oneOf": [
        {
          "const": "task",
          "description": "`T-NNN` — tasks live in `TODO.md` / `BACKLOG.md`, no file.",
          "type": "string"
        },
        {
          "const": "issue",
          "description": "`I-NNN` — one file each under `issues/`.",
          "type": "string"
        },
        {
          "const": "proposal",
          "description": "`P-NNN` — one file each under `proposals/`.",
          "type": "string"
        },
        {
          "const": "adr",
          "description": "`ADR-NNNN` — one file each under `adrs/`.",
          "type": "string"
        },
        {
          "const": "plan",
          "description": "`PL-NNN` — one file each under `plans/`.",
          "type": "string"
        }
      ],
      "title": "ItemKind"
    },
    "NextCounters": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "Per-kind next-counters — `meta.toml`'s `[next]` table.\nMissing keys default to 1 so a partial `[next]` survives a\nhand-edit.",
      "properties": {
        "adr": {
          "default": 1,
          "description": "Next `ADR-NNNN`.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "i": {
          "default": 1,
          "description": "Next `I-NNN`.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "p": {
          "default": 1,
          "description": "Next `P-NNN`.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pl": {
          "default": 1,
          "description": "Next `PL-NNN`.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "t": {
          "default": 1,
          "description": "Next `T-NNN`.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "title": "NextCounters",
      "type": "object"
    },
    "Priority": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "How urgent an item is.",
      "oneOf": [
        {
          "const": "low",
          "description": "`pri:low`",
          "type": "string"
        },
        {
          "const": "medium",
          "description": "`pri:med` — the default when no `pri:` token is present.",
          "type": "string"
        },
        {
          "const": "high",
          "description": "`pri:high`",
          "type": "string"
        },
        {
          "const": "critical",
          "description": "`pri:crit`",
          "type": "string"
        }
      ],
      "title": "Priority"
    },
    "ProjectMeta": {
      "$defs": {
        "NextCounters": {
          "description": "Per-kind next-counters — `meta.toml`'s `[next]` table.\nMissing keys default to 1 so a partial `[next]` survives a\nhand-edit.",
          "properties": {
            "adr": {
              "default": 1,
              "description": "Next `ADR-NNNN`.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "i": {
              "default": 1,
              "description": "Next `I-NNN`.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "p": {
              "default": 1,
              "description": "Next `P-NNN`.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "pl": {
              "default": 1,
              "description": "Next `PL-NNN`.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "t": {
              "default": 1,
              "description": "Next `T-NNN`.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`meta.toml` — the one piece of project state that isn't\nderivable from the item files.",
      "properties": {
        "name": {
          "description": "Repo/project name — used in `# TODO — <name>` and views.",
          "type": "string"
        },
        "next": {
          "$ref": "#/$defs/NextCounters",
          "default": {
            "adr": 1,
            "i": 1,
            "p": 1,
            "pl": 1,
            "t": 1
          },
          "description": "Next-id counters per kind."
        }
      },
      "required": [
        "name"
      ],
      "title": "ProjectMeta",
      "type": "object"
    },
    "Section": {
      "$defs": {
        "Item": {
          "description": "A work item's metadata.\n\n`created` is `Option<Date>` — the spec grammar\n(`- [ ] T-012 title · pri:high · #tag`) has no date slot, so a\nmissing `created` must stay representable; `myco check` can flag\nit later. Emit always writes `created:` when present.\n\n`note` is reserved for handoffs (`myco handoff --note`); kept in\nthe model now so phase 6 doesn't re-shape it.",
          "properties": {
            "blocks": {
              "description": "`blocks:` — ids this item blocks. Sorted set.",
              "items": {
                "$ref": "#/$defs/ItemId"
              },
              "type": "array",
              "uniqueItems": true
            },
            "created": {
              "default": null,
              "description": "`created:` — `YYYY-MM-DD` when known.",
              "type": [
                "string",
                "null"
              ]
            },
            "epic": {
              "description": "`epic:` — the epic (named delivery grouping) this item\nbelongs to. Line token `epic:<name>`; a group name, not a\nlabel — one per item.",
              "type": [
                "string",
                "null"
              ]
            },
            "id": {
              "$ref": "#/$defs/ItemId",
              "description": "Typed id — determines kind, sort, filename."
            },
            "labels": {
              "description": "`#label`s — a sorted set, duplicates impossible.",
              "items": {
                "type": "string"
              },
              "type": "array",
              "uniqueItems": true
            },
            "milestone": {
              "description": "`milestone:` — the milestone this item targets. Line token\n`ms:<name>` (kept short — lines stay readable).",
              "type": [
                "string",
                "null"
              ]
            },
            "note": {
              "description": "Free-form note — handoff/resume payload (phase 6).",
              "type": [
                "string",
                "null"
              ]
            },
            "owner": {
              "description": "`owner:` — `devin`, `human:luis`, …",
              "type": [
                "string",
                "null"
              ]
            },
            "priority": {
              "$ref": "#/$defs/Priority",
              "default": "medium",
              "description": "`pri:` — defaults to [`Priority::Medium`]."
            },
            "status": {
              "$ref": "#/$defs/Status",
              "description": "Lifecycle state — transitions are validated by the caller\nvia [`Status::transition_to`]."
            },
            "superseded_by": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ItemId"
                },
                {
                  "type": "null"
                }
              ],
              "description": "`superseded_by:` — the item that replaced this one (ADRs)."
            },
            "supersedes": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ItemId"
                },
                {
                  "type": "null"
                }
              ],
              "description": "`supersedes:` — the item this one replaces (ADRs)."
            },
            "title": {
              "description": "One-line summary. No `·`, no newlines in line-grammar\ncontexts (enforced at emit, not here — `Item` is a value,\nnot a validator).",
              "type": "string"
            }
          },
          "required": [
            "id",
            "title",
            "status"
          ],
          "type": "object"
        },
        "ItemId": {
          "type": "string"
        },
        "Priority": {
          "description": "How urgent an item is.",
          "oneOf": [
            {
              "const": "low",
              "description": "`pri:low`",
              "type": "string"
            },
            {
              "const": "medium",
              "description": "`pri:med` — the default when no `pri:` token is present.",
              "type": "string"
            },
            {
              "const": "high",
              "description": "`pri:high`",
              "type": "string"
            },
            {
              "const": "critical",
              "description": "`pri:crit`",
              "type": "string"
            }
          ]
        },
        "Status": {
          "description": "Lifecycle status of an [`crate::Item`].",
          "oneOf": [
            {
              "const": "open",
              "description": "Filed, unowned.",
              "type": "string"
            },
            {
              "const": "claimed",
              "description": "Owned by an actor, not yet started.",
              "type": "string"
            },
            {
              "const": "in-progress",
              "description": "Actively worked.",
              "type": "string"
            },
            {
              "const": "blocked",
              "description": "Work started but stuck on a dependency.",
              "type": "string"
            },
            {
              "const": "done",
              "description": "Finished — terminal; done tasks leave `TODO.md`.",
              "type": "string"
            },
            {
              "const": "deferred",
              "description": "Parked — lives in `BACKLOG.md`.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "A named run of items under a `## <section>` heading.",
      "properties": {
        "items": {
          "description": "Items in file order.",
          "items": {
            "$ref": "#/$defs/Item"
          },
          "type": "array"
        },
        "name": {
          "description": "Heading text; `None` = items before the first `##`.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "items"
      ],
      "title": "Section",
      "type": "object"
    },
    "Status": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "Lifecycle status of an [`crate::Item`].",
      "oneOf": [
        {
          "const": "open",
          "description": "Filed, unowned.",
          "type": "string"
        },
        {
          "const": "claimed",
          "description": "Owned by an actor, not yet started.",
          "type": "string"
        },
        {
          "const": "in-progress",
          "description": "Actively worked.",
          "type": "string"
        },
        {
          "const": "blocked",
          "description": "Work started but stuck on a dependency.",
          "type": "string"
        },
        {
          "const": "done",
          "description": "Finished — terminal; done tasks leave `TODO.md`.",
          "type": "string"
        },
        {
          "const": "deferred",
          "description": "Parked — lives in `BACKLOG.md`.",
          "type": "string"
        }
      ],
      "title": "Status"
    },
    "TodoDoc": {
      "$defs": {
        "Item": {
          "description": "A work item's metadata.\n\n`created` is `Option<Date>` — the spec grammar\n(`- [ ] T-012 title · pri:high · #tag`) has no date slot, so a\nmissing `created` must stay representable; `myco check` can flag\nit later. Emit always writes `created:` when present.\n\n`note` is reserved for handoffs (`myco handoff --note`); kept in\nthe model now so phase 6 doesn't re-shape it.",
