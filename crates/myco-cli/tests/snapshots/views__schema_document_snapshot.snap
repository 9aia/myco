      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`TODO.md` — `# TODO — <repo>` plus `## <section>` runs of\n`- [ ] T-NNN …` task items.",
      "properties": {
        "repo": {
          "description": "Repo name from the `# TODO — <repo>` title.",
          "type": "string"
        },
        "sections": {
          "description": "Sections in file order.",
          "items": {
            "$ref": "#/$defs/Section"
          },
          "type": "array"
        }
      },
      "required": [
        "repo",
        "sections"
      ],
      "title": "TodoDoc",
      "type": "object"
    }
