---
source: crates/myco-cli/tests/views.rs
expression: "serde_json::to_string_pretty(&v).unwrap()"
---
{
  "files": {
    "BACKLOG.md": {
      "default_status": "deferred",
      "format": "markdown",
      "line": "- T-NNN <title>[ · <token>]…",
      "schema": "BacklogDoc"
    },
    "TODO.md": {
      "checkbox": "[ ] open — done items are removed, git history keeps them",
      "default_status": "open",
      "format": "markdown",
      "line": "- [ ] T-NNN <title>[ · <token>]…",
      "schema": "TodoDoc",
      "section": "## <name>",
      "title": "# TODO — <repo>"
    },
    "handoffs": {
      "append_only": true,
      "archive": "handoffs/archive/ — files whose item was removed (`check --fix` moves them here)",
      "dir": "handoffs/",
      "entry": "## <YYYY-MM-DD> · <actor>[ · session:<id>] + freeform note body",
      "file": "<ID>.md — one append-only file per item, uniform across kinds",
      "frontmatter_keys": [
        "item"
      ],
      "pattern": "<PREFIX>-NNN.md (e.g. T-001.md, ADR-0004.md)",
      "title": "# Handoffs — <ID>"
    },
    "index.md": {
      "format": "markdown",
      "verbatim": true
    },
    "item_file": {
      "format": "`+++` TOML frontmatter + free-form markdown body",
      "frontmatter_keys": [
        "id",
        "title",
        "status",
        "created",
        "owner",
        "priority",
        "labels",
        "blocks",
        "note",
        "superseded_by",
        "supersedes",
        "epic",
        "milestone"
      ]
    },
    "kinds": {
      "adrs": {
        "archive": "adrs/archive/",
        "dir": "adrs/",
        "pattern": "NNNN-<slug>.md"
      },
      "issues": {
        "archive": "issues/archive/",
        "dir": "issues/",
        "pattern": "issue-NNNN-<slug>.md"
      },
      "plans": {
        "archive": "plans/archive/",
        "dir": "plans/",
        "pattern": "pl-NNNN-<slug>.md"
      },
      "proposals": {
        "archive": "proposals/archive/",
        "dir": "proposals/",
        "pattern": "proposal-NNNN-<slug>.md"
      }
    },
    "meta.toml": {
      "format": "toml",
      "keys": {
        "name": "project/repo name",
        "next": "per-kind next-id counters (t, i, p, adr, pl)"
      },
      "schema": "ProjectMeta"
    }
  },
  "ids": {
    "file_backed": [
      "I",
      "P",
      "ADR",
      "PL"
    ],
    "kinds": {
      "ADR": {
        "counter": "adr",
        "kind": "Adr",
        "width": 4
      },
      "I": {
        "counter": "i",
        "kind": "Issue",
        "width": 3
      },
      "P": {
        "counter": "p",
        "kind": "Proposal",
        "width": 3
      },
      "PL": {
        "counter": "pl",
        "kind": "Plan",
        "width": 3
      },
      "T": {
        "counter": "t",
        "kind": "Task",
        "width": 3
      }
    },
    "shape": "<prefix>-<number>, zero-padded per kind"
  },
  "line_grammar": {
    "actor_pattern": "[A-Za-z0-9._:-]+ (no leading/trailing ':', no '::')",
    "defaults": {
      "pri": "med",
      "status": "doc default (open|deferred)"
    },
    "group_pattern": "[A-Za-z0-9_.-]+ (epic/ms names — `ms` is the milestone token)",
    "label_pattern": "[A-Za-z0-9_-]+",
    "separator": "·",
    "shape": "<id> <title> [· status:<s>] [· pri:<p>] [· owner:<a>] [· created:<YYYY-MM-DD>] [· #<label>]… [· blocks:<id>[,<id>]…] [· epic:<name>] [· ms:<name>] [· note:<text>]",
    "token_order": [
      "status",
      "pri",
      "owner",
      "created",
      "#label",
      "blocks",
      "epic",
      "ms",
      "note"
    ]
  },
  "priorities": [
    "low",
    "med",
    "high",
    "crit"
  ],
  "statuses": [
    "open",
    "claimed",
    "in-progress",
    "blocked",
    "done",
    "deferred"
  ],
  "transitions": {
    "blocked": [
      "in-progress",
      "open",
      "deferred"
    ],
    "claimed": [
      "in-progress",
      "open",
      "deferred"
    ],
    "deferred": [
      "open"
    ],
    "done": [],
    "in-progress": [
      "blocked",
      "done",
      "deferred"
    ],
    "open": [
      "claimed",
      "in-progress",
      "deferred"
    ]
  },
  "types": {
    "BacklogDoc": {
      "$defs": {
        "Item": {
          "description": "A work item's metadata.\n\n`created` is `Option<Date>` — the spec grammar\n(`- [ ] T-012 title · pri:high · #tag`) has no date slot, so a\nmissing `created` must stay representable; `myco check` can flag\nit later. Emit always writes `created:` when present.\n\n`note` is reserved for handoffs (`myco handoff --note`); kept in\nthe model now so phase 6 doesn't re-shape it.",
          "properties": {
            "blocks": {
              "description": "`blocks:` — ids this item blocks. Sorted set.",
              "items": {
                "$ref": "#/$defs/ItemId"
              },
              "type": "array",
              "uniqueItems": true
            },
            "created": {
              "default": null,
              "description": "`created:` — `YYYY-MM-DD` when known.",
              "type": [
                "string",
                "null"
              ]
            },
            "epic": {
              "description": "`epic:` — the epic (named delivery grouping) this item\nbelongs to. Line token `epic:<name>`; a group name, not a\nlabel — one per item.",
              "type": [
                "string",
                "null"
              ]
            },
            "id": {
              "$ref": "#/$defs/ItemId",
              "description": "Typed id — determines kind, sort, filename."
            },
            "labels": {
              "description": "`#label`s — a sorted set, duplicates impossible.",
              "items": {
                "type": "string"
              },
              "type": "array",
              "uniqueItems": true
            },
            "milestone": {
              "description": "`milestone:` — the milestone this item targets. Line token\n`ms:<name>` (kept short — lines stay readable).",
              "type": [
                "string",
                "null"
              ]
            },
            "note": {
              "description": "Free-form note — handoff/resume payload (phase 6).",
              "type": [
                "string",
                "null"
              ]
            },
            "owner": {
              "description": "`owner:` — `devin`, `human:luis`, …",
              "type": [
                "string",
                "null"
              ]
            },
            "priority": {
              "$ref": "#/$defs/Priority",
              "default": "medium",
              "description": "`pri:` — defaults to [`Priority::Medium`]."
            },
            "status": {
              "$ref": "#/$defs/Status",
              "description": "Lifecycle state — transitions are validated by the caller\nvia [`Status::transition_to`]."
            },
            "superseded_by": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ItemId"
                },
                {
                  "type": "null"
                }
              ],
              "description": "`superseded_by:` — the item that replaced this one (ADRs)."
            },
            "supersedes": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ItemId"
                },
                {
                  "type": "null"
                }
              ],
              "description": "`supersedes:` — the item this one replaces (ADRs)."
            },
            "title": {
              "description": "One-line summary. No `·`, no newlines in line-grammar\ncontexts (enforced at emit, not here — `Item` is a value,\nnot a validator).",
              "type": "string"
            }
          },
          "required": [
            "id",
            "title",
            "status"
          ],
          "type": "object"
        },
        "ItemId": {
          "type": "string"
        },
        "Priority": {
          "description": "How urgent an item is.",
          "oneOf": [
            {
              "const": "low",
              "description": "`pri:low`",
              "type": "string"
            },
            {
              "const": "medium",
              "description": "`pri:med` — the default when no `pri:` token is present.",
              "type": "string"
            },
            {
              "const": "high",
              "description": "`pri:high`",
              "type": "string"
            },
            {
              "const": "critical",
              "description": "`pri:crit`",
              "type": "string"
            }
          ]
        },
        "Section": {
          "description": "A named run of items under a `## <section>` heading.",
          "properties": {
            "items": {
              "description": "Items in file order.",
              "items": {
                "$ref": "#/$defs/Item"
              },
              "type": "array"
            },
            "name": {
              "description": "Heading text; `None` = items before the first `##`.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "items"
          ],
          "type": "object"
        },
        "Status": {
          "description": "Lifecycle status of an [`crate::Item`].",
          "oneOf": [
            {
              "const": "open",
              "description": "Filed, unowned.",
              "type": "string"
            },
            {
              "const": "claimed",
              "description": "Owned by an actor, not yet started.",
              "type": "string"
            },
            {
              "const": "in-progress",
              "description": "Actively worked.",
              "type": "string"
            },
            {
              "const": "blocked",
              "description": "Work started but stuck on a dependency.",
              "type": "string"
            },
            {
              "const": "done",
              "description": "Finished — terminal; done tasks leave `TODO.md`.",
              "type": "string"
            },
            {
              "const": "deferred",
              "description": "Parked — lives in `BACKLOG.md`.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`BACKLOG.md` — `# Backlog` plus optional `##` sections of\n`- T-NNN …` items (no checkbox; items are `Deferred`).",
      "properties": {
        "sections": {
          "description": "Sections in file order.",
          "items": {
            "$ref": "#/$defs/Section"
          },
          "type": "array"
        }
      },
      "required": [
        "sections"
      ],
      "title": "BacklogDoc",
      "type": "object"
    },
    "HandoffEntry": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "One `## <date> · <actor>[ · session:<id>]` entry — a dated note\nfrom one actor's session. `session` is provenance only: a sepia\nsession id, `cli:<pid>`, whatever wrote the entry — myco records\nit, never interprets it.",
      "properties": {
        "actor": {
          "description": "Who wrote it — `devin`, `human:luis`, `claude`, …",
          "type": "string"
        },
        "date": {
          "description": "Entry date — `YYYY-MM-DD` in the `## ` heading.",
          "type": "string"
        },
        "note": {
          "description": "Freeform note body — done/next/open, verbatim.",
          "type": "string"
        },
        "session": {
          "description": "Session provenance (`session:<id>` in the heading); absent\nwhen the writer didn't supply one.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "date",
        "actor",
        "note"
      ],
      "title": "HandoffEntry",
      "type": "object"
    },
