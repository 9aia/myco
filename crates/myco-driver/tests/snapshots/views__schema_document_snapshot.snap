    "ProjectMeta": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "ProjectMeta",
      "description": "`meta.toml` — the one piece of project state that isn't\nderivable from the item files. Unknown keys are rejected:\na typo'd table (`[netx]`) would otherwise silently drop the\nreal counters and restart id allocation at 1 — done ids get\nreissued, colliding with their handoffs and history.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Repo/project name — used in `# TODO — <name>` and views.",
          "type": "string"
        },
        "next": {
          "description": "Next-id counters per kind.",
          "$ref": "#/$defs/NextCounters",
          "default": {
            "t": 1,
            "i": 1,
            "p": 1,
            "adr": 1,
            "pl": 1
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "$defs": {
        "NextCounters": {
          "description": "Per-kind next-counters — `meta.toml`'s `[next]` table.\nMissing keys default to 1 so a partial `[next]` survives a\nhand-edit. Builtin kinds keep their fixed keys (`t`, `i`, …);\nuser kinds (P-008) land in `extra` keyed by lowercase prefix\n(`s = 4`). Unknown keys ride `extra` too — the kind table, not\nserde, decides whether a key names a real kind (a typo'd\ncounter can't reissue ids anyway: `observe` floors every\ncounter above the ids on disk).",
          "type": "object",
          "properties": {
            "t": {
              "description": "Next `T-NNN`.",
              "type": "integer",
              "format": "uint32",
              "minimum": 0,
              "default": 1
            },
            "i": {
              "description": "Next `I-NNN`.",
              "type": "integer",
              "format": "uint32",
              "minimum": 0,
              "default": 1
            },
            "p": {
              "description": "Next `P-NNN`.",
              "type": "integer",
              "format": "uint32",
              "minimum": 0,
              "default": 1
            },
            "adr": {
              "description": "Next `ADR-NNNN`.",
              "type": "integer",
              "format": "uint32",
              "minimum": 0,
              "default": 1
            },
            "pl": {
              "description": "Next `PL-NNN`.",
              "type": "integer",
              "format": "uint32",
              "minimum": 0,
              "default": 1
            }
          },
          "additionalProperties": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          }
        }
      }
    },
    "NextCounters": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "NextCounters",
      "description": "Per-kind next-counters — `meta.toml`'s `[next]` table.\nMissing keys default to 1 so a partial `[next]` survives a\nhand-edit. Builtin kinds keep their fixed keys (`t`, `i`, …);\nuser kinds (P-008) land in `extra` keyed by lowercase prefix\n(`s = 4`). Unknown keys ride `extra` too — the kind table, not\nserde, decides whether a key names a real kind (a typo'd\ncounter can't reissue ids anyway: `observe` floors every\ncounter above the ids on disk).",
      "type": "object",
      "properties": {
        "t": {
          "description": "Next `T-NNN`.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 1
        },
        "i": {
          "description": "Next `I-NNN`.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 1
        },
        "p": {
          "description": "Next `P-NNN`.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 1
        },
        "adr": {
          "description": "Next `ADR-NNNN`.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 1
        },
        "pl": {
          "description": "Next `PL-NNN`.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 1
        }
      },
      "additionalProperties": {
        "type": "integer",
        "format": "uint32",
        "minimum": 0
      }
    },
    "Status": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Status",
      "description": "Lifecycle status of an [`crate::Item`].",
      "oneOf": [
        {
          "description": "Filed, unowned.",
          "type": "string",
          "const": "open"
        },
        {
          "description": "Owned by an actor, not yet started.",
          "type": "string",
          "const": "claimed"
        },
        {
          "description": "Actively worked.",
          "type": "string",
          "const": "in-progress"
        },
        {
          "description": "Work started but stuck on a dependency.",
          "type": "string",
          "const": "blocked"
        },
        {
          "description": "Finished — terminal; done tasks leave `TODO.md`.",
          "type": "string",
          "const": "done"
        },
        {
          "description": "Parked — lives in `BACKLOG.md`.",
          "type": "string",
          "const": "deferred"
        },
        {
          "description": "Abandoned — terminal like `done`, but the work was never\ndone; archives into `DONE.md` with the status preserved.",
          "type": "string",
          "const": "cancelled"
        }
      ]
    },
    "Priority": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Priority",
      "description": "How urgent an item is.",
      "oneOf": [
        {
          "description": "`pri:low`",
          "type": "string",
          "const": "low"
        },
        {
          "description": "`pri:med` — the default when no `pri:` token is present.",
          "type": "string",
          "const": "medium"
        },
        {
          "description": "`pri:high`",
          "type": "string",
          "const": "high"
        },
        {
          "description": "`pri:crit`",
          "type": "string",
          "const": "critical"
        }
      ]
    },
    "ItemKind": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "ItemKind",
      "type": "string"
    },
    "ItemId": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "ItemId",
      "type": "string"
    },
    "HandoffEntry": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "HandoffEntry",
      "description": "One `## <date> · <actor>[ · session:<id>]` entry — a dated note\nfrom one actor's session. `session` is provenance only: a sepia\nsession id, `cli:<pid>`, whatever wrote the entry — myco records\nit, never interprets it.",
      "type": "object",
      "properties": {
        "date": {
          "description": "Entry date — `YYYY-MM-DD` in the `## ` heading.",
          "type": "string"
        },
        "actor": {
          "description": "Who wrote it — `devin`, `human:luis`, `claude`, …",
          "type": "string"
        },
        "session": {
          "description": "Session provenance (`session:<id>` in the heading); absent\nwhen the writer didn't supply one.",
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "description": "Freeform note body — done/next/open, verbatim.",
          "type": "string"
        }
      },
      "required": [
        "date",
        "actor",
        "note"
      ]
    }
  },
  "statuses": [
    "open",
    "claimed",
    "in-progress",
    "blocked",
    "done",
    "deferred",
    "cancelled"
  ],
  "priorities": [
    "low",
    "med",
    "high",
    "crit"
  ],
  "transitions": {
    "open": [
      "claimed",
      "in-progress",
      "deferred",
      "cancelled"
    ],
    "claimed": [
      "in-progress",
      "open",
      "deferred",
      "cancelled"
    ],
    "in-progress": [
      "blocked",
      "done",
      "deferred",
      "open",
      "cancelled"
    ],
    "blocked": [
      "in-progress",
      "open",
      "deferred",
      "cancelled"
    ],
    "done": [],
    "deferred": [
      "open",
      "cancelled"
    ],
    "cancelled": []
  },
  "ids": {
    "shape": "<prefix>-<number>, zero-padded per kind",
    "kinds": {
      "T": {
        "kind": "task",
        "width": 3,
        "counter": "t"
      },
      "I": {
        "kind": "issue",
        "width": 3,
        "counter": "i"
      },
      "P": {
        "kind": "proposal",
        "width": 3,
        "counter": "p"
      },
      "ADR": {
        "kind": "adr",
        "width": 4,
        "counter": "adr"
      },
      "PL": {
        "kind": "plan",
        "width": 3,
        "counter": "pl"
      }
    },
    "file_backed": [
      "I",
      "P",
      "ADR",
      "PL"
    ]
  },
  "files": {
    "meta.toml": {
      "format": "toml",
      "schema": "ProjectMeta",
      "keys": {
        "name": "project/repo name",
        "next": "per-kind next-id counters (t, i, p, adr, pl)"
      }
    },
    "TODO.md": {
      "format": "markdown",
      "schema": "TodoDoc",
      "title": "# TODO — <repo>",
      "section": "## <name>",
      "line": "- [ ] T-NNN <title>[ · <token>]…",
      "checkbox": "[ ] open — done items move to DONE.md",
      "children": "a `- [ ]` list indented under an item nests as its sub-items (canonical: 2 spaces/level)",
      "default_status": "open"
    },
    "BACKLOG.md": {
      "format": "markdown",
      "schema": "BacklogDoc",
      "line": "- T-NNN <title>[ · <token>]…",
      "children": "a `-` list indented under an item nests as its sub-items (canonical: 2 spaces/level)",
      "default_status": "deferred"
    },
    "DONE.md": {
      "format": "markdown",
      "schema": "DoneDoc",
      "title": "# Done",
      "line": "- T-NNN <title>[ · <token>]…",
      "children": "a `-` list indented under an item nests as its sub-items (canonical: 2 spaces/level)",
      "default_status": "done",
      "statuses": "done|cancelled — the terminal pair; cancelled keeps its `status:` token",
      "note": "append-only terminal-task archive — `todo done`/`todo cancel`/`item set --status done|cancelled` land here; done and cancelled are terminal"
    },
    "index.md": {
      "format": "markdown",
      "verbatim": true
    },
    "kinds": {
      "issues": {
        "dir": "issues/",
        "pattern": "issue-NNNN-<slug>.md",
        "archive": "issues/archive/"
      },
      "proposals": {
        "dir": "proposals/",
        "pattern": "proposal-NNNN-<slug>.md",
        "archive": "proposals/archive/"
      },
      "adrs": {
        "dir": "adrs/",
        "pattern": "NNNN-<slug>.md",
        "archive": "adrs/archive/"
      },
      "plans": {
        "dir": "plans/",
        "pattern": "pl-NNNN-<slug>.md",
        "archive": "plans/archive/"
      }
    },
    "item_file": {
      "format": "`+++` TOML frontmatter + free-form markdown body",
      "frontmatter_keys": [
        "id",
        "title",
        "status",
        "created",
        "owner",
        "priority",
        "labels",
        "blocks",
        "links",
        "note",
        "superseded_by",
        "supersedes",
        "epic",
        "milestone",
        "due",
        "estimate",
        "cycle"
      ]
    },
    "handoffs": {
      "dir": "handoffs/",
      "file": "<ID>.md — one append-only file per item, uniform across kinds",
      "pattern": "<PREFIX>-NNN.md (e.g. T-001.md, ADR-0004.md)",
      "archive": "handoffs/archive/ — files whose item was removed (`check --fix` moves them here)",
      "frontmatter_keys": [
        "item"
      ],
      "title": "# Handoffs — <ID>",
      "entry": "## <YYYY-MM-DD> · <actor>[ · session:<id>] + freeform note body",
      "append_only": true
    }
  },
  "commits": {
    "subject": "chore: <verb> <id>…",
    "trailer": "Actor: <actor> — the verb's actor (`--actor`/`--owner` where the verb takes one, else the resolved actor: `$MYCO_ACTOR` → `human:<git user.name>` → `cli`)",
    "identity": "author/committer = repo git config (`user.name`/`user.email`, `myco@localhost` fallback) — actor attribution is a trailer, never a per-actor author",
    "timing": "one atomic commit per mutating verb, only when the worktree changed"
  },
  "line_grammar": {
    "shape": "<id> <title> [· status:<s>] [· pri:<p>] [· owner:<a>] [· created:<YYYY-MM-DD>] [· #<label>]… [· blocks:<id>[,<id>]…] [· links:<id>[,<id>]…] [· epic:<name>] [· ms:<name>] [· due:<YYYY-MM-DD>] [· est:<n>] [· cycle:<name>] [· note:<text>]",
    "token_order": [
      "status",
      "pri",
      "owner",
      "created",
      "#label",
      "blocks",
      "links",
      "epic",
      "ms",
      "due",
      "est",
      "cycle",
      "note"
    ],
    "separator": "·",
    "defaults": {
      "status": "doc default (open|deferred|done)",
      "pri": "med",
      "note": "cancelled is never a doc default — it archives in DONE.md with its token"
    },
    "label_pattern": "[A-Za-z0-9_-]+",
    "group_pattern": "[A-Za-z0-9_.-]+ (epic/ms/cycle names — `ms` is the milestone token)",
    "estimate_bound": "0–1000 points (relative size, not hours)",
    "actor_pattern": "[A-Za-z0-9._:-]+ (no leading/trailing ':', no '::')",
    "nesting": "an item's children are a `-`/`[ ]` list indented under it (canonical 2 spaces per level; one level recommended). Children carry the same token grammar — `done`/`defer` on a parent act on the whole subtree, on a child just that node"
  }
}
