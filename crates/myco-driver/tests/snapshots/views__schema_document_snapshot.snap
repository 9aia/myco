        "Status": {
          "description": "Lifecycle status of an [`crate::Item`].",
          "oneOf": [
            {
              "description": "Filed, unowned.",
              "type": "string",
              "const": "open"
            },
            {
              "description": "Owned by an actor, not yet started.",
              "type": "string",
              "const": "claimed"
            },
            {
              "description": "Actively worked.",
              "type": "string",
              "const": "in-progress"
            },
            {
              "description": "Work started but stuck on a dependency.",
              "type": "string",
              "const": "blocked"
            },
            {
              "description": "Finished — terminal; done tasks leave `TODO.md`.",
              "type": "string",
              "const": "done"
            },
            {
              "description": "Parked — lives in `BACKLOG.md`.",
              "type": "string",
              "const": "deferred"
            },
            {
              "description": "Abandoned — terminal like `done`, but the work was never\ndone; archives into `DONE.md` with the status preserved.",
              "type": "string",
              "const": "cancelled"
            }
          ]
        },
        "Priority": {
          "description": "How urgent an item is.",
          "oneOf": [
            {
              "description": "`pri:low`",
              "type": "string",
              "const": "low"
            },
            {
              "description": "`pri:med` — the default when no `pri:` token is present.",
              "type": "string",
              "const": "medium"
            },
            {
              "description": "`pri:high`",
              "type": "string",
              "const": "high"
            },
            {
              "description": "`pri:crit`",
              "type": "string",
              "const": "critical"
            }
          ]
