---
source: crates/myco-driver/tests/views.rs
assertion_line: 140
expression: "serde_json::to_string_pretty(&v).unwrap()"
---
{
  "version": 1,
  "types": {
    "Item": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Item",
      "description": "A work item's metadata.\n\n`created` is `Option<Date>` — the spec grammar\n(`- [ ] T-012 title · pri:high · #tag`) has no date slot, so a\nmissing `created` must stay representable; `myco check` can flag\nit later. Emit always writes `created:` when present.\n\n`note` is reserved for handoffs (`myco handoff --note`); kept in\nthe model now so phase 6 doesn't re-shape it.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Typed id — determines kind, sort, filename.",
          "$ref": "#/$defs/ItemId"
        },
        "title": {
          "description": "One-line summary. No `·`, no newlines in line-grammar\ncontexts (enforced at emit, not here — `Item` is a value,\nnot a validator).",
          "type": "string"
        },
        "status": {
          "description": "Lifecycle state — transitions are validated by the caller\nvia [`Status::transition_to`].",
          "$ref": "#/$defs/Status"
        },
        "priority": {
          "description": "`pri:` — defaults to [`Priority::Medium`].",
          "$ref": "#/$defs/Priority",
          "default": "medium"
        },
        "owner": {
          "description": "`owner:` — `devin`, `human:luis`, …",
          "type": [
            "string",
            "null"
          ]
        },
        "labels": {
          "description": "`#label`s — a sorted set, duplicates impossible.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "blocks": {
          "description": "`blocks:` — ids this item blocks. Sorted set.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/ItemId"
          }
        },
        "links": {
          "description": "`links:` — ids this item is associated with (its plan, the\nproposal that spawned it, …). Kind-agnostic and symmetric —\na declared edge, not a prose mention. Sorted set.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/ItemId"
          }
        },
        "created": {
          "description": "`created:` — `YYYY-MM-DD` when known. Absent (not `null`)\nin JSON — every other `Option` field skips the same way.",
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "description": "Free-form note — handoff/resume payload (phase 6).",
          "type": [
            "string",
            "null"
          ]
        },
        "superseded_by": {
          "description": "`superseded_by:` — the item that replaced this one (ADRs).",
          "anyOf": [
            {
              "$ref": "#/$defs/ItemId"
            },
            {
              "type": "null"
            }
          ]
        },
        "supersedes": {
          "description": "`supersedes:` — the item this one replaces (ADRs).",
          "anyOf": [
            {
              "$ref": "#/$defs/ItemId"
            },
            {
              "type": "null"
            }
          ]
        },
        "epic": {
          "description": "`epic:` — the epic (named delivery grouping) this item\nbelongs to. Line token `epic:<name>`; a group name, not a\nlabel — one per item.",
          "type": [
            "string",
            "null"
          ]
        },
        "milestone": {
          "description": "`milestone:` — the milestone this item targets. Line token\n`ms:<name>` (kept short — lines stay readable).",
          "type": [
            "string",
            "null"
          ]
        },
        "due": {
          "description": "`due:` — the calendar date this item is due, `YYYY-MM-DD`\n(timezone-free, like `created:`).",
          "type": [
            "string",
            "null"
          ]
        },
        "estimate": {
          "description": "`est:` — relative size in points ([`MAX_ESTIMATE`] bound).\nPoints, not hours — teams define their own scale.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "cycle": {
          "description": "`cycle:` — the iteration/sprint this item is scheduled in.\nA group name like `epic:`/`ms:` — existence is a `check`\nconcern, not a parse one (free-form names are legal).",
          "type": [
            "string",
            "null"
          ]
        },
        "children": {
          "description": "Nested sub-items — the `  - [ ]` lines indented under this\none in TODO.md/BACKLOG.md. Children are full items: same\nmetadata, same state machine. Depth is arbitrary (one\nlevel is the recommended shape); `done`/`defer` act on the\nwhole subtree. Empty for file-backed kinds — children only\nexist in the line grammar.",
          "type": "array",
          "items": {
            "$ref": "#"
          }
        }
      },
      "required": [
        "id",
        "title",
        "status"
      ],
      "$defs": {
        "ItemId": {
          "type": "string"
        },
        "Status": {
          "description": "Lifecycle status of an [`crate::Item`].",
          "oneOf": [
            {
              "description": "Filed, unowned.",
              "type": "string",
              "const": "open"
            },
            {
              "description": "Owned by an actor, not yet started.",
              "type": "string",
              "const": "claimed"
            },
            {
              "description": "Actively worked.",
              "type": "string",
              "const": "in-progress"
            },
            {
              "description": "Work started but stuck on a dependency.",
              "type": "string",
              "const": "blocked"
            },
            {
              "description": "Finished — terminal; done tasks leave `TODO.md`.",
              "type": "string",
              "const": "done"
            },
            {
              "description": "Parked — lives in `BACKLOG.md`.",
              "type": "string",
              "const": "deferred"
            },
            {
              "description": "Abandoned — terminal like `done`, but the work was never\ndone; archives into `DONE.md` with the status preserved.",
              "type": "string",
              "const": "cancelled"
            }
          ]
        },
        "Priority": {
          "description": "How urgent an item is.",
          "oneOf": [
            {
              "description": "`pri:low`",
              "type": "string",
              "const": "low"
            },
            {
              "description": "`pri:med` — the default when no `pri:` token is present.",
              "type": "string",
              "const": "medium"
            },
            {
              "description": "`pri:high`",
              "type": "string",
              "const": "high"
            },
            {
              "description": "`pri:crit`",
              "type": "string",
              "const": "critical"
            }
          ]
        }
      }
    },
    "ItemFile": {
